# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite for zero-config local dev; PostgreSQL supported in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sathuragiri_decoration?schema=public"

# JWT Authentication
JWT_SECRET="sathuragiri_super_secret_jwt_key_2026_luxury_events_decor"
JWT_EXPIRES_IN="7d"

# Cookie Security
COOKIE_SECRET="sathuragiri_cookie_secret_key_2026"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Cloudinary / File Storage (Optional - falls back to local static uploads if empty)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Configuration (Optional - falls back to development logging if empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Sathuragiri Decoration <no-reply@sathuragiridecoration.com>"

# Default Seed Credentials (Initial Setup)
SEED_ADMIN_EMAIL="admin@sathuragiridecoration.com"
SEED_ADMIN_PASSWORD="Admin@12345"

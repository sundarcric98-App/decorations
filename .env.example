# ===============================================================
# Sathuragiri Decoration — Environment Configuration Template
# ===============================================================

# ---------------------------------------------------------------
# Frontend Environment Variables (Vite - Public Browser Context)
# ---------------------------------------------------------------
# IMPORTANT: Only public keys safe for browser exposure use VITE_ prefix.
# Never expose the SUPABASE_SERVICE_ROLE_KEY in frontend variables!
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
VITE_API_BASE_URL="http://localhost:5000/api"

# ---------------------------------------------------------------
# Backend Environment Variables (Express & Vercel Functions)
# ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Supabase Server Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# PostgreSQL Connection String (Optional, for scripts/database pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Initial Admin Account Setup (used by scripts/seed-admin.cjs)
SEED_ADMIN_EMAIL="admin@sathuragiridecoration.com"
SEED_ADMIN_PASSWORD="Admin@12345"
